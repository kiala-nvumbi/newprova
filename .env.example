# ==============================================================================
# Sistema de Provas Online - Gestão Estratégica
# Copie este ficheiro para .env e preencha os valores adequados ao seu ambiente.
# NUNCA submeta o ficheiro .env real para o GitHub.
# ==============================================================================

# Servidor HTTP
PORT=3000
NODE_ENV=production

# URL pública da aplicação
APP_URL="http://localhost:3000"

# ==============================================================================
# Base de Dados PostgreSQL / Cloud SQL
# Pode fornecer DATABASE_URL OU as variáveis individuais SQL_* abaixo.
# ==============================================================================
DATABASE_URL="postgres://usuario:senha@host:5432/nome_bd"
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="provas_gestao"
SQL_SSL=false

# ==============================================================================
# Segurança e Autenticação
# ==============================================================================
# Chave secreta longa e aleatória (mínimo 32 caracteres) para assinar tokens HMAC/cookies
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Palavra-passe da conta de Administrador (utilizador: kiala.nvumbi)
# Defina uma palavra-passe forte em produção
ADMIN_PASSWORD=""

# ==============================================================================
# Integrações Opcionais
# ==============================================================================
# Chave da API Gemini (apenas se utilizar funcionalidades de IA no servidor)
GEMINI_API_KEY=""

# Configuração Firebase Web (opcional; use variáveis de ambiente no GitHub/Cloud)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
